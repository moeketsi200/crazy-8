    "server-logs": "sdk-commands sdk-server-logs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.31.1-40536151736.commit-a09f320",
    "@dcl/sdk": "7.31.1-40536151736.commit-a09f320"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "dependencies": {
    "@dcl/crypto-middleware": "^6.5.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
